# Copy to .env (gitignored). Then:
#   node "ByoU-English Speaking App/scripts/write-config.mjs"
#
# Anthropic and Sarvam keys belong in Supabase Edge Function secrets, not here:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
#   npx supabase secrets set SARVAM_API_KEY=...

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
