# Copy to .env (gitignored). Then:
#   node "ByoU-English Speaking App/scripts/write-config.mjs"
#
# Anthropic stays in Supabase Edge Function secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=...
#
# SARVAM_API_KEY belongs in Vercel → Settings → Environment Variables
# (server-only, used by /api/transcribe). Do not put it in client JS.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
